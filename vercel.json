{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "functions": {
    "app/api/queues/ping-reminder/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "space-safari-ping-reminders",
          "retryAfterSeconds": 30,
          "initialDelaySeconds": 0
        }
      ]
    }
  }
}
