# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_SHORT_NAME=

# Public deployment URL, no trailing slash. The app falls back to this canonical domain.
APP_URL=https://spacesafari.jordy.beer

# Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Random secret used to derive opaque private group-room IDs (falls back to webhook secret)
MAP_ROOM_SECRET=

# Comma-separated Telegram numeric user IDs allowed to calibrate the festival map
MAP_ADMIN_TELEGRAM_IDS=

# Optional random admin secret for /api/telegram/register-webhook
WEBHOOK_ADMIN_SECRET=
