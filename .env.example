# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_SHORT_NAME=

# Public deployment URL, no trailing slash. The app falls back to this canonical domain.
APP_URL=https://ginder.jordy.beer

# Upstash Redis REST (Vercel Marketplace may instead inject KV_REST_API_URL + KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random secret used to derive opaque private group-room IDs (falls back to webhook secret)
MAP_ROOM_SECRET=

# Comma-separated Telegram numeric user IDs allowed to calibrate the built-in map.
# Owners of user-created festivals can calibrate their own festival automatically.
MAP_ADMIN_TELEGRAM_IDS=

# Optional random admin secret for /api/telegram/register-webhook
WEBHOOK_ADMIN_SECRET=

# WhatsApp Cloud API / Groups API (optional experiment)
# Groups API access is restricted by Meta. Leave these empty when using Telegram only.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Explicit Graph API version, for example the version enabled for your Meta app.
WHATSAPP_GRAPH_VERSION=
